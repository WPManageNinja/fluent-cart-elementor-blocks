{
  "scripts": {
    "dev": "node resources/vite/vite.js && vite",
    "watch": "npm run dev",
    "build": "node resources/vite/vite.js --build && vite build",
    "production": "npm run build",
    "prod": "npm run build",
    "build:zip": "npm run build && npm run i18n && npm run pack",
    "i18n": "wp i18n make-pot . language/fluent-cart-elementor-blocks.pot --domain=fluent-cart-elementor-blocks --exclude=resources,builds,node_modules,vendor,assets",
    "pack": "node resources/dev/zip.js",
    "zip": "node resources/dev/zip.js"
  },
  "dependencies": {
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "glob": "^13.0.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.6",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0"
  }
}
